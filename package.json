{
  "name": "tech-opportunities",
  "version": "1.0.0",
  "description": "Local tech jobs dashboard for international remote work and UK/EU sponsorship",
  "scripts": {
    "validate": "tsx validator/validate-scraper-output.ts",
    "validate:tech": "tsx validator/validate-scraper-output.ts data_in_progress/jobs/tech_opportunities",
    "scrape:tech": "tsx data_in_progress/jobs/tech_opportunities/scraper.ts",
    "reclassify:tech": "tsx tech/reclassify.ts",
    "build": "vite build --config dashboard/vite.config.ts",
    "start": "tsx tech/server.ts",
    "dev": "npm run build && npm start",
    "test": "tsx --test tech/tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.tech.json",
    "discover:tech": "tsx tech/discover-cli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "agentmail": "^0.2.15",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.57.0",
    "playwright": "^1.40.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^8.3.4"
  }
}
